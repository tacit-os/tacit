#!/bin/bash
# tacit-update now|cancel|tonight|cancel-tonight|night|install|pre|post: Tacit's updates, installed while the computer restarts (systemd's
# offline updates, systemd.offline-updates(7)). tacit-fetch-updates has already downloaded them.
#   now      the next start installs them (the notch's or Settings' Restart, through tacit-update@now.service); not on
#            a battery under 20 % that is not charging
#   cancel   takes the link of now away again when the restart was refused (the shell runs as the user, / is root's)
#   tonight  at 03:00, left on, on the charger, with the screen locked, Caffeine off and no agent mid-turn
#            (tacit-update-night.timer wakes the computer for it, never on battery)
#   cancel-tonight  Settings' Cancel beside it: the timer off, and nothing left of the choice
#   night    what that timer runs; any of those not so: the next night, and /var/lib/tacit/night says why. Nothing
#            waiting any more ends Tonight.
#   install  what the start runs before anything else (tacit-system-update.service); then it restarts
#   pre/post the sleep hook (/usr/lib/systemd/system-sleep/tacit-update links here): asleep on battery, the timer waits
# How it went is /var/lib/tacit/update-result, which the shell says once in the notch.
set -u
state=/var/lib/tacit
mkdir -p "$state"

# on the charger, or a computer without a battery (always is)
charger() {
	local d mains=0 battery=0
	for d in /sys/class/power_supply/*; do
		# a wireless mouse's battery is not the computer's
		[ "$(cat "$d/scope" 2>/dev/null)" = Device ] && continue
		case "$(cat "$d/type" 2>/dev/null)" in
			Mains|USB|USB_C|USB_PD*) [ "$(cat "$d/online" 2>/dev/null)" = 1 ] && mains=1 ;;
			Battery) battery=1 ;;
		esac
	done
	[ "$mains" = 1 ] || [ "$battery" = 0 ]
}

# the computer's battery in %, its lowest one as tacit-fetch-updates reads it; nothing without one
level() {
	local d c low=""
	for d in /sys/class/power_supply/*; do
		[ "$(cat "$d/scope" 2>/dev/null)" = Device ] && continue
		[ "$(cat "$d/type" 2>/dev/null)" = Battery ] || continue
		c=$(cat "$d/capacity" 2>/dev/null)
		[[ $c =~ ^[0-9]+$ ]] && { [ -z "$low" ] || [ "$c" -lt "$low" ]; } && low=$c
	done
	echo "$low"
}

# an agent-host session mid-turn (working, or waiting on a permission), from the hello the host sends every client on
# connect: what Restart and the session screen warn of (SessionWarnings.qml). No host, or no answer in 3 s, is none.
agent_working() {
	[ -S "$1" ] || return 1
	python3 -I -c '
import json, socket, sys
s = socket.socket(socket.AF_UNIX); s.settimeout(3); s.connect(sys.argv[1])
hello = json.loads(s.makefile(encoding="utf-8").readline())
sys.exit(0 if any(x.get("state") in ("working", "waiting") for x in hello.get("sessions", [])) else 1)' "$1" 2>/dev/null
}

# What became of a night, for the shell to say: "" once it goes ahead, else why it did not install. Skipped, the unit
# ended as a success with no record, and Settings went on saying Tonight as if it would happen.
said() {
	printf '{"at": %s, "skipped": "%s"}\n' "$(date +%s)" "$1" > "$state/night.new"
	chmod 644 "$state/night.new"
	mv "$state/night.new" "$state/night"
}
skip() {
	said "$1"
	exit 0
}

# Before a restart that installs: a download still running is stopped (cleanly: KillSignal=SIGINT), a lock left by one
# stopped another way is cleared, and what the install needs is downloaded now, while the computer is online. The install
# at the start has no network: a Restart pressed during a download killed it, and the install found pacman's lock and
# the files missing (Discord, 2026-10-20).
ready() {
	systemctl stop tacit-fetch-updates.service tacit-fetch-updates-now.service 2>/dev/null
	# held is asked of the lock file (libalpm keeps it open), not of the name: a pacman -Qu lookup is not a download
	if [ -e /var/lib/pacman/db.lck ] && [ -z "$(find /proc/[0-9]*/fd -lname /var/lib/pacman/db.lck -print -quit 2>/dev/null)" ]; then
		rm -f /var/lib/pacman/db.lck
	fi
	# in English whatever the system's language: the shell reads what stopped it from this (Updates.qml's failureCause)
	LC_ALL=C pacman -Suw --noconfirm --noprogressbar > "$state/download.log" 2>&1
}

case "${1:-}" in
now)
	# under 20 % and not plugged in the install at the start could outlast the battery and stop half done: refused, with
	# the level for the shell to say (Updates.qml). The session screen's Restart then restarts without installing.
	b=$(level)
	if ! charger && [ -n "$b" ] && [ "$b" -lt 20 ]; then
		echo "tacit: battery $b" > "$state/download.log"
		exit 1
	fi
	# a download that failed restarts nothing: the install at the start has no network and would fail
	ready || exit 1
	# Restart now replaces Tonight: the enabled timer would fire again at the next 03:00
	systemctl disable --now tacit-update-night.timer 2>/dev/null
	ln -sfn /var/cache/pacman/pkg /system-update
	;;
cancel)
	rm -f /system-update
	;;
tonight)
	# enabled, not only started: a restart before three o'clock keeps Tonight
	systemctl enable --now tacit-update-night.timer || exit 1
	# when it was chosen: a night that came after with no word from it was a night the computer was off
	touch "$state/tonight"
	;;
cancel-tonight)
	systemctl disable --now tacit-update-night.timer || exit 1
	# and a sleep on battery under way does not start it again on waking (post)
	rm -f "$state/tonight" /run/tacit-update-held
	;;
night)
	# nothing waiting any more (put in meanwhile by Apps' "Update everything" or pacman in a terminal), counted as the
	# shell counts it, without what IgnorePkg holds: no restart, and Tonight is over. The night restarted into an empty
	# install, which restarted again, closing every app for nothing.
	if ! pacman -Qu 2>/dev/null | grep -v ' \[ignored\]$' | grep -q ' -> '; then
		systemctl disable --now tacit-update-night.timer
		exit 0
	fi
	# three o'clock, not later: a timer that came due while the computer slept fires as it wakes, with the person at the
	# lock screen. A night missed is never made up as the computer starts or wakes; the next one comes.
	now=$(date +%s)
	hm=$(date -d "@$now" +%-H%M)
	[ "$hm" -ge 300 ] && [ "$hm" -lt 330 ] || skip asleep
	charger || skip battery
	# someone at the computer at three in the morning keeps their work: only a locked screen restarts
	for s in $(loginctl list-sessions --no-legend | awk '{print $1}'); do
		# the sign-in screen is an unlocked graphical session too, with nobody at it
		[ "$(loginctl show-session "$s" -p Class --value)" = greeter ] && continue
		[ "$(loginctl show-session "$s" -p Active --value)" = yes ] && [ "$(loginctl show-session "$s" -p Type --value)" = wayland ] || continue
		uid=$(loginctl show-session "$s" -p User --value)
		run=$(loginctl show-user "$uid" -p RuntimePath --value)
		# Caffeine on (the shell's mark, Idle.qml) is someone keeping the screen awake, locked or not
		[ -e "$run/tacit-caffeine" ] && skip caffeine
		# Tacit's lock tells logind; the boot lock and hyprlock, its fallback, do not
		[ "$(loginctl show-session "$s" -p LockedHint --value)" = yes ] || pgrep -U "$uid" -f 'bootlock[.]qml' >/dev/null \
			|| pgrep -U "$uid" -x hyprlock >/dev/null || skip unlocked
		# a Praxis turn left running behind the lock is work going on: the restart cut it off half done
		agent_working "$run/agent-host.sock" && skip agent
	done
	said ""
	# the timer is stopped only once the download is here: offline at three, the next night tries again (it was stopped
	# first, and Tonight was lost without a word)
	ready || { said download; exit 1; }
	systemctl disable --now tacit-update-night.timer
	ln -sfn /var/cache/pacman/pkg /system-update
	systemctl reboot
	;;
install)
	# The screen says what the minutes are for, and to leave the computer on: it showed the boot picture, then black once
	# the splash let the display go (about 40 s), and nothing else until the restart. Plain dots: the console's own font
	# has no ellipsis.
	printf "\n\n  Installing updates... Don't switch off.\n" > /dev/console
	# taken away first: an install that fails can never run again at every start
	rm -f /system-update
	# nothing else runs at this point of the start: a lock is one a stopped pacman left behind
	rm -f /var/lib/pacman/db.lck
	before=$(pacman -Q)
	pacman -Su --noconfirm --noprogressbar > "$state/update.log" 2>&1
	rc=$?
	after=$(pacman -Q)
	untouched=false
	[ "$before" = "$after" ] && untouched=true
	ok=false
	[ "$rc" = 0 ] && ok=true
	# the versions now installed stay in the cache, the ones they replaced go: pacman never clears it, and with a fetch
	# every two hours a small disk filled. A failed install keeps everything for the next try.
	[ "$rc" = 0 ] && pacman -Sc --noconfirm >> "$state/update.log" 2>&1
	printf '{"at": %s, "ok": %s, "untouched": %s, "version": "%s"}\n' "$(date +%s)" "$ok" "$untouched" \
		"$(pacman -Q tacit 2>/dev/null | awk '{print $2}')" > "$state/update-result.new"
	chmod 644 "$state/update-result.new"
	mv "$state/update-result.new" "$state/update-result"
	# the updates are in, however they were started: a Tonight chosen earlier must not come back after this start
	systemctl disable --now tacit-update-night.timer 2>/dev/null
	systemctl reboot
	;;
pre)
	# Asleep on battery the night's timer would wake the computer for nothing (WakeSystem=true, then no charger): it is
	# stopped for the sleep, still enabled, and started again on waking, when it waits for the next three o'clock.
	charger && exit 0
	systemctl -q is-active tacit-update-night.timer || exit 0
	now=$(date +%s)
	three=$(date -d "$(date -d "@$now" +%F) 03:00" +%s)
	[ "$now" -lt "$three" ] || three=$(date -d "$(date -d "@$now" +%F) 03:00 tomorrow" +%s)
	echo "$three" > /run/tacit-update-held
	systemctl stop tacit-update-night.timer
	;;
post)
	[ -e /run/tacit-update-held ] || exit 0
	three=$(cat /run/tacit-update-held)
	rm -f /run/tacit-update-held
	systemctl start --no-block tacit-update-night.timer
	# three o'clock came while it slept: that night was one on battery
	[ "$(date +%s)" -lt "$three" ] || said battery
	;;
*)
	echo "usage: tacit-update now|cancel|tonight|cancel-tonight|night|install|pre|post" >&2
	exit 2
	;;
esac
