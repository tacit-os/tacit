#!/bin/bash
# tacit-fetch-updates: keep this computer's list of packages fresh and download the waiting updates, never install them
# (macOS's "Download new updates when available"). Getting an app in Apps then finds the updates it comes with already here.
# Runs as the system from tacit-fetch-updates.timer. Skips quietly while pacman is busy, on battery under 40 %, on a metered connection, or offline.
# (From ~/dev/tacit-updates 5b2428e; tacit-session installs it.)
set -u

# A check asked for in Settings takes over from the background run: that one is at the lowest priority and idle I/O and a
# download of hundreds of MB could keep the press spinning for many minutes. It is stopped (SIGINT: pacman lets go of its
# lock and keeps the part downloaded, the next download carries on from it) and this run goes on at full speed.
if [ "${1:-}" = now ] && [ "$(systemctl is-active tacit-fetch-updates.service 2>/dev/null)" = activating ]; then
    timeout 60 systemctl stop tacit-fetch-updates.service
fi

# A check asked for in Settings keeps what stopped it in fetch.log, which Settings reads to say so (Updates.qml's
# failureCause): a busy package manager, the live USB, or pacman's own words, in English whatever the system's language
log=/dev/null
if [ "${1:-}" = now ]; then
    log=/var/lib/tacit/fetch.log
    install -d /var/lib/tacit && : > "$log"
fi

# pacman at work: not now. A lock with nothing holding it is one a stopped pacman left (a restart in the middle of a
# download), and kept every later download from starting. Who holds it is asked of the lock file itself (libalpm keeps
# it open while it works), not of the name "pacman": the shell's own pacman -Qu and -Sup lookups carry that name too,
# and another package tool's lock is not pacman's to clear
if [ -e /var/lib/pacman/db.lck ]; then
    # asked for in Settings: only the background download running is a check under way; anything else (an install in the
    # Store) means nothing was checked, and the unit must not end as a success
    if [ -n "$(find /proc/[0-9]*/fd -lname /var/lib/pacman/db.lck -print -quit 2>/dev/null)" ]; then
        [ "${1:-}" = now ] && ! systemctl is-active --quiet tacit-fetch-updates.service && { echo "tacit: busy" >> "$log"; exit 75; }
        exit 0
    fi
    rm -f /var/lib/pacman/db.lck
fi

# the unit's archiso condition skipped it as a success, which Settings read as a check that worked
[ "${1:-}" = now ] && [ -e /run/archiso ] && { echo "tacit: live USB" >> "$log"; exit 75; }

on_mains=0 battery=""
for d in /sys/class/power_supply/*; do
    # a wireless mouse's battery is not the computer's
    [ "$(cat "$d/scope" 2>/dev/null)" = Device ] && continue
    case "$(cat "$d/type" 2>/dev/null)" in
        Mains|USB|USB_C|USB_PD*) [ "$(cat "$d/online" 2>/dev/null)" = 1 ] && on_mains=1 ;;
        Battery) c=$(cat "$d/capacity" 2>/dev/null) && [ -n "$c" ] && { [ -z "$battery" ] || [ "$c" -lt "$battery" ]; } && battery=$c ;;
    esac
done
# asked for in Settings (tacit-fetch-updates-now.service): the person wants it, whatever the battery says
if [ "${1:-}" != now ] && [ "$on_mains" = 0 ] && [ -n "$battery" ] && [ "$battery" -lt 40 ]; then
    echo "on battery at ${battery} %: not now"
    exit 0
fi

# the background run does not spend a metered connection (a phone's hotspot reads as guessed); Settings' own ask does
if [ "${1:-}" != now ] && nmcli -t -g GENERAL.METERED dev show 2>/dev/null | grep -q '^yes'; then
    echo "metered connection: not now"
    exit 0
fi

# -Syuw: refresh the list and download what the next update needs; nothing is installed or removed
LC_ALL=C pacman -Syuw --noconfirm --noprogressbar 2>&1 | tee -a "$log"
rc=${PIPESTATUS[0]}
[ "$rc" = 0 ] || exit "$rc"
# when the last look worked, whether or not anything had changed: pacman leaves a list it finds current untouched, and
# Settings' "Checked at" (the lists' time) went back to when something last came
install -d /var/lib/tacit && touch /var/lib/tacit/updates-checked

# Every new version of the big packages lands in the cache and nothing took the superseded ones out until an install at
# a restart succeeded: a postponed restart, a failed install or an update done in Apps left them all. What stays: the
# files the waiting update installs (pacman -Sc would take those too: they are not installed yet) and the versions
# installed now (paccache is pacman-contrib's, which Tacit does not install). A lookup that fails prunes nothing.
# It holds pacman's own lock while it works, taken as pacman takes it (made only if there is none) and kept open, so the
# stale-lock test above sees it held: an install from Apps or a terminal downloads into the cache, and its package,
# neither installed yet nor in the waiting update, was deleted under it and the install failed. A pacman already at
# work: no prune this time; one that starts meanwhile is refused as busy, as during the download.
lock=/var/lib/pacman/db.lck
{ set -C; exec 9> "$lock"; } 2>/dev/null || exit 0
set +C
trap 'rm -f -- "$lock"' EXIT
cache=/var/cache/pacman/pkg
waiting=$(pacman -Sup --print-format '%f') || exit 0
installed=$(pacman -Q | awk '{print $1 "-" $2}')
[ -n "$installed" ] || exit 0
for f in "$cache"/*.pkg.tar.*; do
    [ -f "$f" ] || continue
    base=${f##*/}
    case $base in *.sig) continue ;; esac
    grep -qxF -- "$base" <<< "$waiting" && continue
    # name-version-arch.pkg.tar.zst; an epoch's colon can be written %3A in a file name
    key=${base%.pkg.tar.*}
    key=${key%-*}
    grep -qxF -- "${key//%3A/:}" <<< "$installed" && continue
    rm -f -- "$f" "$f.sig"
done
