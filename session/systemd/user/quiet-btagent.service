[Unit]
Description=Bluetooth pairing agent for the Tacit shell
# BlueZ is the whole point of the program, but it does not wait for it: with no bluetoothd the agent stays up and
# registers when org.bluez appears, again after each restart of bluetoothd. So no condition on an adapter: a unit
# skipped at login is never tried again, and a USB dongle plugged in later got no agent (pairing Refused, no sheet).
After=tacit-session.target
PartOf=tacit-session.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/lib/tacit/bin/quiet-btagent
# A crash while nothing is pairing costs nothing; a crash loop should not be silent, so the
# restart is slow enough to read in the journal.
Restart=on-failure
RestartSec=5
MemoryHigh=32M

[Install]
WantedBy=tacit-session.target
