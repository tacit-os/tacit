#!/usr/bin/env python3
"""tacit-login-ground: the person's lock ground and colours for Tacit's login screen. Run as root before the first
greeter (sddm.service.d/tacit-login.conf) and again as a person logs out (tacit-login-ground.service, started by the
shell), so the greeter that comes back shows the wallpaper chosen since: the greeter runs as the sddm user, who cannot
read home folders.

Takes the newest lock ground among the people on this computer (with one person, theirs; tacit-boot-ground writes it
on every wallpaper change) and their colours, into /var/lib/tacit-login: ground.png and theme.conf, which the theme's
theme.conf.user links to. Only a plain file the person owns is read, never a link, a pipe or someone else's file.
Nothing found: the theme's own fallbacks (Tacit's palette, no picture).

It also gives the greeter's compositor (weston) that person's keyboard layout, the one chosen in Settings or else the
one Setup chose (/etc/vconsole.conf, with Setup's switch between a pair of layouts), as a [keyboard] section in
/etc/xdg/weston/weston.ini; weston reads that file when it is there and starts without it when it is not (--config would
refuse to start). A file of someone else's at that path is left alone.
"""
import json, os, pwd, re, shutil, stat, tempfile

OUT = "/var/lib/tacit-login"
VCONSOLE = "/etc/vconsole.conf"
XKB = "/usr/share/X11/xkb/symbols"
WESTON_INI = "/etc/xdg/weston/weston.ini"
MARK = "# written by tacit-login-ground"
KEYS = {"surface": "surface", "surfaceContainerHigh": "surface_container_high", "onSurface": "on_surface",
        "onSurfaceVariant": "on_surface_variant", "primary": "primary", "error": "error"}

def owned(path, uid):
    """an open file object for a plain file `uid` owns, else None"""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_size > 64 << 20:
        os.close(fd)
        return None
    return os.fdopen(fd, "rb")

def vconsole(key):
    try:
        with open(VCONSOLE) as f:
            m = re.search(r"^" + key + r"=[\"']?([^\"'\n]*)", f.read(), re.M)
    except OSError:
        return ""
    return m.group(1) if m else ""

def chosen_layout(p):
    """the layout `p` chose in Settings (Config's hyprland.input.kbLayout in their shell's config.json), "" for Setup's.
    A password typed at the lock in that layout gave another password at the greeter, in Setup's"""
    src = owned(os.path.join(p.pw_dir, ".config/illogical-impulse/config.json"), p.pw_uid) if p else None
    if not src:
        return ""
    try:
        with src:
            conf = json.load(src)
        layout = conf["hyprland"]["input"]["kbLayout"]
        version = conf.get("configVersion", 0)
    except (ValueError, OSError, KeyError, TypeError, AttributeError):
        return ""
    # "us" in a file from before settings version 5 is the old default, not a choice (Config.qml's migrate())
    if not isinstance(layout, str) or (layout == "us" and not (isinstance(version, int) and version >= 5)):
        return ""
    return layout

def usable(layout):
    return re.fullmatch(r"[A-Za-z0-9_]+(,[A-Za-z0-9_]+)*", layout) \
        and all(os.path.isfile(os.path.join(XKB, l)) for l in layout.split(","))

def keyboard(chosen=""):
    """the keyboard section of the greeter's weston.ini: the layout chosen in Settings, else what Setup wrote to
    /etc/vconsole.conf; None when it names no layout this computer has: a keymap weston cannot build would leave the
    greeter with no keys at all"""
    setup = vconsole("XKBLAYOUT")
    layout = chosen if chosen and usable(chosen) else setup
    if not usable(layout):
        return None
    layouts = layout.split(",")
    section = ["[keyboard]", f"keymap_layout={layout}"]
    # one variant for each layout, each one the layout's file has (an empty one is the layout's own): Setup's, for
    # Setup's layout
    variant = vconsole("XKBVARIANT") if layout == setup else ""
    variants = variant.split(",")
    if len(variants) == len(layouts) and any(variants) and all(
            re.fullmatch(r"[A-Za-z0-9_]*", v) and (not v or re.search(r'xkb_symbols\s+"' + v + '"', open(os.path.join(XKB, l)).read()))
            for l, v in zip(layouts, variants)):
        section.append(f"keymap_variant={variant}")
    # Setup's switch between a pair of layouts (grp:alt_shift_toggle), which Hyprland also takes from there: without it a
    # us,ru greeter could never type the second one
    options = vconsole("XKBOPTIONS")
    if "," in layout and re.fullmatch(r"[A-Za-z0-9_:+-]+(,[A-Za-z0-9_:+-]+)*", options):
        section.append(f"keymap_options={options}")
    return "\n".join(section)

def weston_keyboard(chosen=""):
    try:
        with open(WESTON_INI) as f:
            ours = f.readline().startswith(MARK)
    except OSError:
        ours = False
    if os.path.lexists(WESTON_INI) and not ours:
        return
    section = keyboard(chosen)
    if section is None:
        if ours:
            os.remove(WESTON_INI)
        return
    os.makedirs(os.path.dirname(WESTON_INI), mode=0o755, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=os.path.dirname(WESTON_INI), delete=False) as tmp:
        tmp.write(MARK + "\n" + section + "\n")
    os.chmod(tmp.name, 0o644)
    os.replace(tmp.name, WESTON_INI)

def main():
    best = None
    for p in pwd.getpwall():
        if not 1000 <= p.pw_uid < 60000 or not p.pw_dir.startswith("/"):
            continue
        g = os.path.join(p.pw_dir, ".local/state/tacit-boot/lock-ground.png")
        try:
            st = os.lstat(g)
        except OSError:
            continue
        if stat.S_ISREG(st.st_mode) and st.st_uid == p.pw_uid and (best is None or st.st_mtime > best[0]):
            best = (st.st_mtime, p)
    # the keyboard of the person whose ground the greeter shows
    try:
        weston_keyboard(chosen_layout(best[1] if best else None))
    except OSError:
        pass
    os.makedirs(OUT, mode=0o755, exist_ok=True)
    if best is None:
        for f in ("ground.png", "theme.conf"):
            try: os.remove(os.path.join(OUT, f))
            except OSError: pass
        return
    p = best[1]
    lines = ["[General]"]
    src = owned(os.path.join(p.pw_dir, ".local/state/tacit-boot/lock-ground.png"), p.pw_uid)
    if src:
        with src, tempfile.NamedTemporaryFile(dir=OUT, delete=False) as tmp:
            shutil.copyfileobj(src, tmp)
        os.chmod(tmp.name, 0o644)
        os.replace(tmp.name, os.path.join(OUT, "ground.png"))
        lines.append(f"ground={OUT}/ground.png")
    src = owned(os.path.join(p.pw_dir, ".local/state/quickshell/user/generated/colors.json"), p.pw_uid)
    if src:
        try:
            with src:
                colors = json.load(src)
            for k, j in KEYS.items():
                v = str(colors.get(j, ""))
                if len(v) == 7 and v.startswith("#") and all(c in "0123456789abcdefABCDEF" for c in v[1:]):
                    lines.append(f"{k}={v}")
        except (ValueError, OSError):
            pass
    with tempfile.NamedTemporaryFile("w", dir=OUT, delete=False) as tmp:
        tmp.write("\n".join(lines) + "\n")
    os.chmod(tmp.name, 0o644)
    os.replace(tmp.name, os.path.join(OUT, "theme.conf"))

if __name__ == "__main__":
    main()
