#!/bin/sh
# window-close-watch <address> <pid> <class>
#
# Super+Q only asks a window to close. A window that never does (an app stopped on its own error, as Discord does when the
# terminal it was started from is gone; Discord, FlorpiC) stayed on screen with no way out but a terminal. A few seconds
# after the key this checks that the same window is still there and says so, with Force quit. Nothing is stopped unless the
# person presses it; an app that is asking something first (Save changes?) is also still there, so the words allow for it.
addr=${1#0x} pid=${2:-0} cls=$3
case $pid in '' | *[!0-9]*) exit 0 ;; esac
[ "$pid" -gt 1 ] || exit 0
# The window by its stable id, taken at once: its address can be given to a new window as soon as it is gone. The app's
# windows are noted too, so a new one from it (a Save changes? of its own) is the app asking, and nothing is said.
now=$(hyprctl -j clients 2>/dev/null)
win=$(printf '%s' "$now" | jq -r --arg a "$addr" --argjson p "$pid" 'first(.[] | select((.address | ltrimstr("0x")) == $a and .pid == $p and .mapped)) | .stableId' 2>/dev/null)
[ -n "$win" ] || exit 0
had=$(printf '%s' "$now" | jq -c --argjson p "$pid" '[.[] | select(.pid == $p) | .stableId]' 2>/dev/null)
here() {
	hyprctl -j clients 2>/dev/null | jq -e --arg w "$win" 'any(.[]; .stableId == $w and .mapped)' >/dev/null 2>&1
}
asking() {
	hyprctl -j clients 2>/dev/null | jq -e --argjson p "$pid" --argjson had "${had:-[]}" 'any(.[]; .pid == $p and .mapped and (.stableId | IN($had[]) | not))' >/dev/null 2>&1
}
sleep 6
here && ! asking || exit 0
out=$(mktemp) || exit 0
trap 'rm -f "$out"' EXIT
notify-send -a Tacit -t 15000 -p -A "kill=Force quit" "${cls:-An app} is still open" "It may be asking you something first." >"$out" &
note=$!
# The note goes as soon as the window does, so an app that only took longer to close is not left looking stuck.
while kill -0 "$note" 2>/dev/null; do
	sleep 1
	here && ! asking && continue
	id=$(head -n 1 "$out")
	[ -n "$id" ] && gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications \
		--method org.freedesktop.Notifications.CloseNotification "$id" >/dev/null 2>&1
	kill "$note" 2>/dev/null
	exit 0
done
[ "$(sed -n 2p "$out")" = kill ] || exit 0
# the same window, not one that took its place meanwhile
here && kill -0 "$pid" 2>/dev/null || exit 0
kill -TERM "$pid" 2>/dev/null
sleep 2
kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
exit 0
