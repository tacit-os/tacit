#!/bin/sh
# What the focused window is, for Claude's context chips (services/Claude.qml): its app and
# title, the folder it is in (focus-folder), the command running in a terminal, the file and
# line open in Graphis. One JSON object on stdout; anything not known is an empty string.
# Password managers and private browser windows give nothing at all.
T_BIN=${TACIT_BIN:-$HOME/.local/bin}                          # Tacit's launchers (the package sets TACIT_BIN)
TACIT_SHELL=${TACIT_SHELL:-$HOME/.config/quickshell/tacit}  # the shell's folder (the package sets TACIT_SHELL)
w=$(hyprctl activewindow -j 2>/dev/null)
class=$(printf %s "$w" | jq -r '.class // empty')
title=$(printf %s "$w" | jq -r '.title // empty')
pid=$(printf %s "$w" | jq -r '.pid // empty')
case "$class" in
    *[Kk]ee[Pp]ass*|*1[Pp]assword*|*[Bb]itwarden*) echo '{}'; exit 0 ;;
esac
case "$title" in
    *"Private Browsing"*|*"Private browsing"*|*"Private Window"*|*"Incognito"*|*"InPrivate"*) title="" ;;
esac
# Opsis (class browser, browser-cef) titles a private window "Private · <page>"
case "$class" in browser|browser-cef) case "$title" in Private|"Private · "*) title="" ;; esac ;; esac
# Other browsers say "private" in the window's own language ("Privater Modus", "Navigation privée"),
# which no list here can cover. A normal window's title ends with the browser's name, so for the
# browsers services/Claude.qml knows the title is kept only when it does; anything after the name
# may be the private mark, and the title is dropped.
brand=""
case "$class" in
    zen) brand="Zen Browser" ;;
    firefox) brand="Mozilla Firefox" ;;
    chromium) brand="Chromium" ;;
    google-chrome) brand="Google Chrome" ;;
    brave-browser) brand="Brave" ;;
    vivaldi-stable) brand="Vivaldi" ;;
esac
[ -n "$brand" ] && case "$title" in
    "$brand"|*" — $brand"|*" – $brand"|*" - $brand") ;;
    *) title="" ;;
esac
# Any other browser (Edge, LibreWolf, Floorp, a Firefox or Chromium build with a class of its own): its private mark is
# not known here, so its title is dropped whole. It is known by its class's name, or by its launcher saying it is one.
[ -z "$brand" ] && [ -n "$title" ] && case "$class" in
    browser|browser-cef) ;;
    *[Ff]irefox*|*[Ww]olf*|*[Ff]loorp*|*[Zz]en*|*[Cc]hrom*|*[Bb]rave*|*[Vv]ivaldi*|*[Ee]dge*|*[Oo]pera*|*[Ee]piphany*|\
    *[Ff]alkon*|*qutebrowser*|*[Mm]ullvad*|*[Tt]or[Bb]rowser*|*[Ll]adybird*|*[Mm]idori*) title="" ;;
    *)
        for d in "${XDG_DATA_HOME:-$HOME/.local/share}" $(printf %s "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr : ' '); do
            for f in "$d/applications/$class.desktop" $(grep -lsxF "StartupWMClass=$class" "$d"/applications/*.desktop); do
                grep -qs '^Categories=.*WebBrowser' "$f" && title=""
            done
        done ;;
esac
cwd=""
if [ "$class" = praxis ]; then
    # Praxis: the open session's folder
    cwd=$(timeout 2 qs -p "$TACIT_SHELL/claude.qml" ipc call claudeapp state 2>/dev/null | jq -r '.cwd // empty' 2>/dev/null)
    [ -d "$cwd" ] || cwd=""
fi
[ -n "$cwd" ] || cwd=$("$T_BIN/focus-folder")
cmd="" file="" line="" root=""
case "$class" in
    foot|footclient|kitty|Alacritty|com.mitchellh.ghostty)
        # what the shell runs in the foreground (claude, make, nvim), not that program's helpers
        sh=$(pgrep -P "$pid" | head -1)
        fg=$([ -n "$sh" ] && pgrep -P "$sh" | tail -1)
        [ -n "$fg" ] && cmd=$(cat "/proc/$fg/comm" 2>/dev/null) ;;
    graphis)
        # the editor has a window class of its own, so the class is the whole test
        P="$TACIT_SHELL/code.qml"
        root=$(timeout 2 qs -p "$P" ipc call code root 2>/dev/null)
        s=$(timeout 2 qs -p "$P" ipc call code state 2>/dev/null)
        file=$(printf %s "$s" | jq -r '.rel // empty' 2>/dev/null)
        line=$(printf %s "$s" | jq -r '.line // empty' 2>/dev/null) ;;
esac
jq -nc --arg class "$class" --arg title "$title" --arg cwd "$cwd" --arg cmd "$cmd" \
    --arg root "$root" --arg file "$file" --arg line "$line" \
    '{class: $class, title: $title, cwd: $cwd, cmd: $cmd, root: $root, file: $file, line: $line}'
