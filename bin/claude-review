#!/usr/bin/env python3
# The review actions the Claude app's Review panel and Code share (one implementation, called
# from both): the uncommitted hunks of a repository or of some of its files, compared with the
# last commit, and reverting one hunk with an undo.
#
#   claude-review hunks <dir> [path ...]      JSON on stdout; no paths = every change in <dir>'s repo
#   claude-review edits <dir> < items.json    one turn's own edits (the app's tool items) as hunks
#   claude-review revert <dir> <path> <id> [<ms>]   reverse-apply one hunk; prints the undo patch. With <ms> (when
#                                             the agent's edit was written), a file written since is left alone
#                                             and {"changed": true} printed
#   claude-review restore <dir> <patch>       put a reverted hunk back (<dir>: inside its repo)
#   claude-review status <dir>                branch, upstream, ahead/behind, remote, GitHub + gh
#   claude-review draft <dir> [path ...]      a commit message for those changes (claude -p, haiku)
#   claude-review commit <dir> <msg> [path ...]   stage those paths (all if none) and commit
#   claude-review push <dir>                  push; sets the upstream on the first push
#   claude-review pr <dir>                    open GitHub's pull request page (gh --web)
#
# With paths, each file's own repository is used, so a session that runs in ~ and edits files
# in several repositories reviews them all; a file in no repository is listed without hunks.
#
# A new file git does not track yet shows as one hunk of added lines and cannot be reverted
# here (that would mean deleting it). Undo patches live in $XDG_RUNTIME_DIR/claude-review.
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys

EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
UNDO = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "claude-review")
MAX_NEW_LINES = 400
NET_TIMEOUT = 120   # seconds: the panel runs one action at a time, so a stuck push must end
MAX_NEW_BYTES = 1 << 20   # a bigger new file is listed without its lines, not read
# A project with no .gitignore has thousands of new files (node_modules, a build, a venv): the first ones are read,
# up to these, and the rest only counted, so the panel is not left waiting on megabytes of JSON.
MAX_NEW_FILES = 200
MAX_NEW_TOTAL = 4 << 20
# The diff parse() reads and git apply takes back, as git itself writes it whatever the person's config says:
# diff.noprefix and diff.mnemonicPrefix change the a/ and b/ the names are cut from and git apply -R strips, and an
# external diff or a textconv driver prints text that is not the file's.
DIFF = ("diff", "--no-color", "--no-renames", "-U2", "--no-ext-diff", "--no-textconv", "--src-prefix=a/", "--dst-prefix=b/")


def run(cmd, **kw):
    # Bytes in, text out: text=True would turn CRLF into LF (an undo patch that no longer matches
    # its file) and fail on a file that is not UTF-8; surrogateescape keeps every byte as it was.
    r = subprocess.run(cmd, capture_output=True, **kw)
    r.stdout = r.stdout.decode("utf-8", "surrogateescape")
    r.stderr = r.stderr.decode("utf-8", "surrogateescape")
    return r


def git(repo, *args, **kw):
    # no optional locks: a read must not take index.lock, or a git the person runs meanwhile fails
    return run(["git", "--no-optional-locks", "-C", repo, "-c", "core.quotePath=false", *args], **kw)


def last_line(text, fallback):
    return (text.strip().splitlines() or [fallback])[-1]


def toplevel(d):
    r = run(["git", "-C", d, "rev-parse", "--show-toplevel"])
    return r.stdout.strip() if r.returncode == 0 else None


def base(repo):
    return "HEAD" if git(repo, "rev-parse", "--verify", "-q", "HEAD").returncode == 0 else EMPTY_TREE


def inside(repo, paths):
    out = []
    for p in paths:
        a = os.path.realpath(p)
        if a.startswith(repo + "/"):
            out.append(a[len(repo) + 1:])
    return out


def hid(path, body):
    return hashlib.sha1((path + "\n" + body).encode("utf-8", "surrogateescape")).hexdigest()[:12]


def parse(diff):
    files, cur, hunk = [], None, None
    for line in diff.split("\n"):
        if line.startswith("diff --git "):
            # no renames, so both names are the same and the name is the part after "a/", halved
            rest = line[len("diff --git a/"):]
            name = rest[:(len(rest) - 3) // 2]
            cur = {"path": name, "status": "M", "header": [line], "hunks": [], "add": 0, "del": 0, "binary": False}
            files.append(cur)
            hunk = None
            continue
        if cur is None:
            continue
        if line.startswith("@@"):
            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", line)
            hunk = {"head": line, "lines": [], "line": int(m.group(1)) if m else 1, "add": 0, "del": 0}
            cur["hunks"].append(hunk)
            continue
        if hunk is None:
            if line.startswith("new file mode"):
                cur["status"] = "A"
            elif line.startswith("deleted file mode"):
                cur["status"] = "D"
            elif line.startswith("Binary files"):
                cur["binary"] = True
            cur["header"].append(line)
            continue
        if line.startswith("\\") or (line and line[0] in "+- "):
            hunk["lines"].append(line)
            if line.startswith("+"):
                hunk["add"] += 1
                cur["add"] += 1
            elif line.startswith("-"):
                hunk["del"] += 1
                cur["del"] += 1
    for f in files:
        f["patch"] = "\n".join(f["header"])
        for h in f["hunks"]:
            h["body"] = h["head"] + "\n" + "\n".join(h["lines"])
            h["id"] = hid(f["path"], h["body"])
    return files


def untracked(repo, rel):
    """The new files git does not track, and how many more there were than are listed."""
    out, more, total = [], 0, 0
    names = git(repo, "ls-files", "--others", "--exclude-standard", "-z", "--", *rel).stdout.split("\0")
    for p in filter(None, names):
        if len(out) >= MAX_NEW_FILES or total > MAX_NEW_TOTAL:
            more += 1
            continue
        try:
            path = os.path.join(repo, p)
            st = os.stat(path)
            if not stat.S_ISREG(st.st_mode) or st.st_size > MAX_NEW_BYTES:   # a pipe would block the read
                raise OSError
            with open(path, encoding="utf-8") as fh:
                text = fh.read()
        except (UnicodeDecodeError, OSError):
            out.append({"path": p, "status": "U", "add": 0, "del": 0, "binary": True, "hunks": []})
            continue
        total += st.st_size
        lines = text.split("\n")
        if lines and lines[-1] == "":
            lines.pop()
        shown = ["+" + l for l in lines[:MAX_NEW_LINES]]
        body = f"@@ -0,0 +1,{len(lines)} @@\n" + "\n".join(shown)
        out.append({"path": p, "status": "U", "add": len(lines), "del": 0, "binary": False,
                    "hunks": [{"id": hid(p, body), "line": 1, "body": body, "add": len(lines), "del": 0,
                               "cut": len(lines) > MAX_NEW_LINES}]})
    return out, more


def repo_files(repo, rel):
    files = parse(git(repo, *DIFF, base(repo), "--", *rel).stdout)
    new, unlisted = untracked(repo, rel)
    files += new
    for f in files:
        f["abs"] = os.path.join(repo, f["path"])
        f["repo"] = repo
        f.pop("header", None)
        f.pop("patch", None)
        for h in f["hunks"]:
            h.pop("head", None)
            h.pop("lines", None)
    return files, unlisted


def hunks(d, paths):
    if not paths:
        repo = toplevel(d)
        files, unlisted = repo_files(repo, []) if repo else ([], 0)
        return {"repo": repo, "files": files, "unlisted": unlisted}
    groups, outside, tops = {}, [], {}   # tops: a folder's repository, asked once per folder
    for p in paths:
        a = os.path.realpath(p)
        d = os.path.dirname(a)
        if d not in tops:
            tops[d] = toplevel(d) if os.path.isdir(d) else None
        repo = tops[d]
        if repo:
            groups.setdefault(repo, []).append(a)
        else:
            outside.append({"path": a, "abs": a, "repo": None, "status": "?", "add": 0, "del": 0, "hunks": [], "outside": True})
    files, unlisted = [], 0
    for repo, members in groups.items():
        got, more = repo_files(repo, inside(repo, members))
        files += got
        unlisted += more
    return {"repo": next(iter(groups), None), "files": files + outside, "unlisted": unlisted}


def locate(text, new, lines):
    """The first line of `new` in the file as it is now; 0 when it is no longer there."""
    if text is None or not new.strip():
        return 0
    i = text.find(new.rstrip("…"))
    if i >= 0:
        return text.count("\n", 0, i) + 1
    for k, l in enumerate(lines):   # changed since: the first line that says something
        if l.strip():
            have = text.split("\n")
            for n, h in enumerate(have):
                if h == l:
                    return max(1, n + 1 - k)
            break
    return 0


def edit_hunks(path, old, new, start):
    """old -> new as hunks with two lines of context, numbered from `start` (0: not known)."""
    import difflib
    a = old.split("\n") if old else []
    b = new.split("\n") if new else []
    out = []
    for group in difflib.SequenceMatcher(None, a, b, autojunk=False).get_grouped_opcodes(2):
        body, add, dele = [], 0, 0
        for tag, i1, i2, j1, j2 in group:
            if tag == "equal":
                body += [" " + l for l in a[i1:i2]]
                continue
            body += ["-" + l for l in a[i1:i2]]
            body += ["+" + l for l in b[j1:j2]]
            dele += i2 - i1
            add += j2 - j1
        line = start + group[0][3] if start else 0
        text = f"@@ -{group[0][1] + 1} +{line} @@\n" + "\n".join(body)
        out.append({"id": hid(path, text), "line": line, "body": text, "add": add, "del": dele})
    return out


def patch_parts(patch, d):
    """apply_patch text (Codex): (path, status, [(old, new)]) per file."""
    parts, cur, old, new = [], None, [], []
    def end_hunk():
        if cur is not None and (old or new):
            cur[2].append(("\n".join(old), "\n".join(new)))
    for line in patch.split("\n"):
        m = re.match(r"\*\*\* (Add|Update|Delete) File: (.+)", line)
        if m:
            end_hunk(); old, new = [], []
            p = m.group(2).strip()
            cur = (p if p.startswith("/") else os.path.join(d, p), {"Add": "A", "Delete": "D"}.get(m.group(1), "M"), [])
            parts.append(cur)
        elif cur is None or line.startswith("*** "):
            continue
        elif line.startswith("@@"):
            end_hunk(); old, new = [], []
        elif line[:1] in "+- " and line:
            if line[0] != "+": old.append(line[1:])
            if line[0] != "-": new.append(line[1:])
    end_hunk()
    return parts


def edits(d, items, created):
    """A turn's changes as its tool calls made them, so git's state does not matter: a file outside
    any repository, one committed since, or one with older uncommitted changes all show just this
    turn's edits. Same shape as hunks(); nothing here can be reverted (the turn's Undo can)."""
    files, texts, tops = {}, {}, {}
    def entry(path, status):
        a = os.path.realpath(os.path.expanduser(path))
        if a not in files:
            dd = os.path.dirname(a)
            if dd not in tops:
                tops[dd] = toplevel(dd) if os.path.isdir(dd) else None
            repo = tops[dd]
            files[a] = {"path": a[len(repo) + 1:] if repo else a, "abs": a, "repo": repo, "status": status,
                        "add": 0, "del": 0, "binary": False, "hunks": [], "turn": True}
            try:
                with open(a, encoding="utf-8") as fh:
                    texts[a] = fh.read()
            except (UnicodeDecodeError, OSError):
                texts[a] = None
        return files[a]
    def put(f, old, new):
        new_lines = new.split("\n") if new else []
        for h in edit_hunks(f["path"], old, new, locate(texts[f["abs"]], new, new_lines)):
            f["hunks"].append(h)
            f["add"] += h["add"]
            f["del"] += h["del"]
    for it in items:
        tool, paths = it.get("tool", ""), it.get("files") or []
        if tool == "apply_patch":
            for path, status, pairs in patch_parts(it.get("patch", ""), d):
                f = entry(path, status)
                for old, new in pairs:
                    put(f, old, new)
        elif tool == "Write" and paths:
            f = entry(paths[0], "A" if paths[0] in created else "M")
            text = texts[f["abs"]]
            new = it.get("new", "")
            if new.endswith("…") and text is not None:   # clipped by the host: the file has it whole
                new = text
            lines = new.split("\n")
            if lines and lines[-1] == "":
                lines.pop()
            cut = len(lines) > MAX_NEW_LINES
            put(f, "", "\n".join(lines[:MAX_NEW_LINES]))
            if cut and f["hunks"]:
                f["hunks"][-1]["cut"] = True
        elif paths:
            f = entry(paths[0], "M")
            pairs = zip((it.get("old") or "").split("\n⋯\n"), (it.get("new") or "").split("\n⋯\n"))
            for old, new in pairs:
                put(f, old, new)
    for f in files.values():
        f["hunks"].sort(key=lambda h: h["line"] or 1 << 30)
    return {"repo": next((f["repo"] for f in files.values() if f["repo"]), None), "files": list(files.values())}


def written_after(path, ms):
    try:
        return os.stat(path).st_mtime_ns // 1_000_000 > ms
    except OSError:   # deleted: nothing of anyone's to lose there
        return False


def revert(d, path, want, since=0):
    repo = toplevel(os.path.dirname(os.path.realpath(path))) or toplevel(d)
    if not repo:
        sys.exit("not a git repository")
    rel = inside(repo, [path])
    if not rel:
        sys.exit("that file is not in this repository")
    for f in parse(git(repo, *DIFF, base(repo), "--", rel[0]).stdout):
        for h in f["hunks"]:
            if h["id"] != want:
                continue
            if since and written_after(path, since):
                print(json.dumps({"ok": False, "changed": True}))
                return
            os.makedirs(UNDO, exist_ok=True)
            pf = os.path.join(UNDO, h["id"] + ".patch")
            with open(pf, "w", encoding="utf-8", errors="surrogateescape", newline="") as fh:
                fh.write(f["patch"] + "\n" + h["body"] + "\n")
            r = git(repo, "apply", "-R", pf)
            if r.returncode:
                sys.exit(r.stderr.strip() or "the change could not be taken back")
            print(json.dumps({"ok": True, "undo": pf}))
            return
    sys.exit("that change is no longer there")


def restore(d, pf):
    repo = toplevel(d)
    if not repo:
        sys.exit("not a git repository")
    r = git(repo, "apply", pf)
    if r.returncode:
        sys.exit(r.stderr.strip() or "the change could not be put back")
    print(json.dumps({"ok": True}))


def status(d):
    repo = toplevel(d)
    if not repo:
        return {"repo": None}
    branch = git(repo, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    upstream = git(repo, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    up = upstream.stdout.strip() if upstream.returncode == 0 else ""
    ahead = behind = 0
    if up:
        counts = git(repo, "rev-list", "--left-right", "--count", f"{up}...HEAD").stdout.split()
        if len(counts) == 2:
            behind, ahead = int(counts[0]), int(counts[1])
    remote = git(repo, "remote", "get-url", "origin").stdout.strip()
    gh = shutil.which("gh") is not None
    return {"repo": repo, "branch": branch, "upstream": up, "ahead": ahead, "behind": behind,
            "remote": remote, "github": "github.com" in remote, "gh": gh}


def draft(d, paths):
    repo = toplevel(d)
    if not repo:
        sys.exit("not a git repository")
    rel = inside(repo, paths) if paths else []
    diff = git(repo, "diff", "--no-color", base(repo), "--", *rel).stdout
    for p in git(repo, "ls-files", "--others", "--exclude-standard", "--", *rel).stdout.splitlines():
        diff += f"\nnew file: {p}\n"
    if not diff.strip():
        sys.exit("nothing to commit in these files")
    style = git(repo, "log", "-8", "--format=%s").stdout.strip()
    prompt = ("Write the commit message for this diff. Match the style of these recent subjects:\n"
              f"{style or '(no commits yet: use a short imperative subject)'}\n\n"
              "A subject line under 72 characters; a short body only if the change needs one. "
              "Reply with the message only, no quotes, no code fences.")
    try:
        r = subprocess.run(["claude", "-p", "--model", "haiku", prompt], input=diff[:40000].encode("utf-8", "replace").decode(),
                           capture_output=True, text=True, timeout=120)
    except OSError:
        sys.exit("claude is not installed")
    except subprocess.TimeoutExpired:
        sys.exit("no message came back in time")
    if r.returncode or not r.stdout.strip():
        sys.exit(last_line(r.stderr, "no message came back"))
    print(r.stdout.strip())


def commit(d, message, paths):
    repo = toplevel(d)
    if not repo:
        sys.exit("not a git repository")
    if not message.strip():
        sys.exit("the message is empty")
    rel = inside(repo, paths) if paths else []
    if paths and not rel:
        sys.exit("those files are not in this repository")
    r = git(repo, "add", "--", *rel) if rel else git(repo, "add", "-A")
    if r.returncode:
        sys.exit(r.stderr.strip() or "could not stage")
    # with paths, only those go in: a plain commit would take whatever else is already staged
    r = git(repo, "commit", "-m", message, *(["--", *rel] if rel else []))
    if r.returncode:
        sys.exit(last_line(r.stderr.strip() or r.stdout, "could not commit"))
    print(json.dumps({"ok": True, "hash": git(repo, "rev-parse", "--short", "HEAD").stdout.strip()}))


def push(d):
    st = status(d)
    if not st["repo"]:
        sys.exit("not a git repository")
    if not st["remote"]:
        sys.exit("this repository has no remote")
    args = ["push"] if st["upstream"] else ["push", "-u", "origin", "HEAD"]
    try:   # no prompt for a password: nobody sees it, and the push would wait for good
        r = git(st["repo"], *args, env={**os.environ, "GIT_TERMINAL_PROMPT": "0"}, timeout=NET_TIMEOUT)
    except subprocess.TimeoutExpired:
        sys.exit("the push took too long")
    if r.returncode:
        sys.exit(last_line(r.stderr, "push failed"))
    print(json.dumps({"ok": True}))


def pr(d):
    st = status(d)
    if not st["repo"] or not st["github"] or not st["gh"]:
        sys.exit("a GitHub remote and gh are needed")
    try:
        r = subprocess.run(["gh", "pr", "create", "--web", "--fill"], cwd=st["repo"], capture_output=True, text=True,
                           env={**os.environ, "GH_PROMPT_DISABLED": "1"}, timeout=NET_TIMEOUT)
    except subprocess.TimeoutExpired:
        sys.exit("gh took too long")
    if r.returncode:
        sys.exit(last_line(r.stderr, "gh failed"))
    print(json.dumps({"ok": True}))


if __name__ == "__main__":
    if len(sys.argv) < 3:
        sys.exit(__doc__ or "usage: claude-review hunks|revert|restore <dir> ...")
    cmd, d = sys.argv[1], sys.argv[2]
    if cmd == "hunks":
        print(json.dumps(hunks(d, sys.argv[3:])))
    elif cmd == "edits":
        req = json.load(sys.stdin)
        print(json.dumps(edits(d, req.get("items", []), set(req.get("created", [])))))
    elif cmd == "revert" and len(sys.argv) in (5, 6):
        revert(d, sys.argv[3], sys.argv[4], int(sys.argv[5]) if len(sys.argv) == 6 else 0)
    elif cmd == "restore" and len(sys.argv) == 4:
        restore(d, sys.argv[3])
    elif cmd == "status":
        print(json.dumps(status(d)))
    elif cmd == "draft":
        draft(d, sys.argv[3:])
    elif cmd == "commit" and len(sys.argv) >= 4:
        commit(d, sys.argv[3], sys.argv[4:])
    elif cmd == "push":
        push(d)
    elif cmd == "pr":
        pr(d)
    else:
        sys.exit("usage: claude-review hunks|revert|restore <dir> ...")
