#!/usr/bin/env node
// tests/config/make-releases: writes releases/, the settings file each past release left on a computer, from git: that
// release's Config.qml (the commit tacit-packages pinned for tacit-shell), its JsonAdapter's defaults run through its own
// migrate(), as a first start writes them. Releases that wrote the same file share one, named after the first of them;
// index.json says which. "lived" is a file that went through every release in turn, each one reading it into its own
// adapter and migrating it. Run it when a release ships, with its line added below; the files are kept in the repo so
// the tests need no history.
import { execFileSync } from "child_process";
import { mkdirSync, rmSync, writeFileSync } from "fs";
import { dirname, join } from "path";
import { fileURLToPath } from "url";
import { adapterDefaults, loadInto, runMigrate } from "../lib/qml.mjs";

// tacit's version and the tacit-shell commit its last package of that version was built from (tacit-packages,
// tacit-shell/PKGBUILD)
const RELEASES = [
  ["1.0.2", "40fbb1b"], ["1.1.0", "f046162"], ["1.1.2", "b19a5cb"], ["1.1.3", "b5242fa"], ["1.1.4", "e7bf556"],
  ["1.1.5", "3116e65"], ["1.1.6", "d1ab934"], ["1.1.7", "4802fde"], ["1.1.8", "375b941"], ["1.2", "3104525"],
  ["1.2.1", "a9d8663"], ["1.2.2", "f937683"], ["1.2.3", "2ee58a6"], ["1.2.4", "6bdbb03"], ["1.2.5", "132ff86"],
  ["1.2.6", "77d730a"], ["1.2.7", "d4f8c65"], ["1.2.8", "52aaac1"], ["1.2.9", "da27813"], ["1.2.10", "3dc1e82"],
  ["1.2.11", "8067f85"], ["1.2.12", "3585005"], ["1.2.13", "ca089d1"], ["1.2.14", "cebcc1f"],
];

const here = dirname(fileURLToPath(import.meta.url));
const out = join(here, "releases");
rmSync(out, { recursive: true, force: true });
mkdirSync(out);
const config = c => execFileSync("git", ["-C", here, "show", `${c}:modules/common/Config.qml`], { encoding: "utf8" });
const text = o => JSON.stringify(o, null, 2) + "\n";

const files = new Map(), index = [];
let lived = null;
for (const [version, commit] of RELEASES) {
  const src = config(commit);
  const defaults = adapterDefaults(src);
  // a first start: the defaults are written (configVersion 0), read back and migrated
  const t = text(runMigrate(src, loadInto(defaults, {})).options);
  if (!files.has(t)) files.set(t, `${version}.json`);
  index.push({ version, commit, file: files.get(t) });
  lived = runMigrate(src, loadInto(defaults, lived ?? {})).options;
}
if (!files.has(text(lived))) files.set(text(lived), "lived.json");
index.push({ version: `${RELEASES[0][0]} to ${RELEASES.at(-1)[0]}, one after another`, commit: "", file: files.get(text(lived)) });
for (const [t, name] of files) writeFileSync(join(out, name), t);
writeFileSync(join(out, "index.json"), JSON.stringify(index, null, 1) + "\n");
console.log(`${index.length} releases in ${files.size} files in ${out}`);
